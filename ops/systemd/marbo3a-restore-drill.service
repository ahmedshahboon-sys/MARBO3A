[Unit]
Description=MARBO3A isolated latest-backup restore verification
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/marbo3a
ExecStart=/usr/bin/env bash /opt/marbo3a/ops/verify-latest-backup.sh /opt/marbo3a
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
