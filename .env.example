# MARBO3A production environment template — never commit real secrets
POSTGRES_DB=marbo3a
POSTGRES_USER=marbo3a
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://marbo3a:CHANGE_ME@db:5432/marbo3a
REDIS_URL=redis://redis:6379
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000
PG_QUERY_TIMEOUT_MS=20000
PG_IDLE_TX_TIMEOUT_MS=30000
PG_SLOW_QUERY_MS=750

APP_ORIGIN=https://marbo3a.ly
# Optional comma-separated trusted aliases for credentialed browser CORS/CSRF validation.
APP_ORIGIN_ALIASES=https://www.marbo3a.ly
NEXT_PUBLIC_APP_ORIGIN=https://marbo3a.ly
UPLOAD_DIR=/app/uploads

# Bounded API observability. Errors and slow requests are always recorded; successful requests are sampled.
SLOW_REQUEST_MS=1200
REQUEST_LOG_SAMPLE_RATE=0.02

# Encrypted database backup. BACKUP_AGE_RECIPIENT is the public age recipient, never the private key.
# Keep BACKUP_AGE_IDENTITY outside the repository and point it to the private identity only for restore verification.
BACKUP_AGE_RECIPIENT=CHANGE_ME_AGE_PUBLIC_RECIPIENT
BACKUP_AGE_IDENTITY=/root/.config/marbo3a/backup-age-key.txt
BACKUP_RETENTION_DAYS=14
# Production backups require a separately managed/mounted offsite destination.
BACKUP_REQUIRE_OFFSITE=true
BACKUP_OFFSITE_DIR=/mnt/offsite/marbo3a

# Google OAuth / OpenID Connect
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://marbo3a.ly/api/auth/oauth/google/callback

# Facebook Login / Meta OAuth
FACEBOOK_APP_ID=CHANGE_ME
FACEBOOK_APP_SECRET=CHANGE_ME
FACEBOOK_REDIRECT_URI=https://marbo3a.ly/api/auth/oauth/facebook/callback
FACEBOOK_GRAPH_VERSION=v24.0

# Media storage. Local works out of the box. For S3/R2/MinIO set STORAGE_DRIVER=s3 and configure the fields below.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/uploads
STORAGE_PUBLIC_PREFIX=/api/uploads
# S3_BUCKET=marbo3a
# S3_REGION=auto
# S3_ENDPOINT=https://YOUR-S3-ENDPOINT
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# S3_KEY_PREFIX=marbo3a
# S3_ACCESS_KEY_ID=CHANGE_ME
# S3_SECRET_ACCESS_KEY=CHANGE_ME
# S3_FORCE_PATH_STYLE=false

# Cloudflare Turnstile — optional abuse escalation. Both keys are required before the admin can enable CAPTCHA escalation.
TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME

# Web Push — generated safely during deployment if missing/placeholder.
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:admin@marbo3a.ly

# WebRTC / TURN
TURN_HOST=marbo3a.ly
TURN_EXTERNAL_IP=YOUR_PUBLIC_IPV4
TURN_REALM=marbo3a.ly
TURN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
TURN_FORCE_RELAY=false
# TURN relay capacity plan: 49152-49663 (512 ports) in compose.yml.
# Secret rotation is explicit: ROTATE_TURN_SECRET=true bash ops/setup-turn.sh during a maintenance window.
ROOM_VOICE_MAX_PARTICIPANTS=24
ROOM_VOICE_MAX_SPEAKERS=6
# Optional TLS TURN endpoint only when separately configured without conflicting with HTTPS/Nginx.
# TURN_TLS_HOST=turn.marbo3a.ly
# TURN_TLS_PORT=5349
